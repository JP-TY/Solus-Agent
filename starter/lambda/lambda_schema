    "inputSchema": {
      "type": "object",
      "properties": {
        "application_id": {
          "type": "string",
          "description": "Net-metering application ID (NM-XXXXXXXX)"
        }
      },
      "required": [
        "application_id"
      ]
    }
  },
  {
    "name": "get_interconnection_checklist",
    "description": "Get documentary checklist for DU interconnection.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "distribution_utility": {
          "type": "string",
          "description": "Distribution utility name"
        }
      },
      "required": [
        "distribution_utility"
      ]
    }
  }
